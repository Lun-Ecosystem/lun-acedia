{
  "name": "lun-acedia",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "workspaces": [
    "server",
    "views",
    "app"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev -w @lun-acedia/server",
    "demo": "npm run -s demo -w @lun-acedia/server",
    "pair-code": "npm run -s pair-code -w @lun-acedia/server",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:colors": "node scripts/check-colors.mjs",
    "typecheck": "tsc --noEmit && npm run check -w @lun-ecosystem/lunacedia-views && npm run check -w @lun-acedia/app",
    "pina:eval": "npm run -s pina:eval -w @lun-acedia/server --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
