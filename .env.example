# Copier en .env et renseigner. Ne jamais versionner .env.
# Local : clés de développement et compte Google de test uniquement.
# Adresse d'écoute : 127.0.0.1 par défaut (ce poste seulement). Un déploiement donne son adresse.
HOST=127.0.0.1
PORT=8787
DB_PATH=./data/acedia.db
# Clé de chiffrement des jetons Google : 32 octets en base64
# (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
ACEDIA_SECRET_KEY=
# Client OAuth Google (type « Application Web »), voir docs/brancher-google.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Par défaut : http://localhost:<PORT>/oauth/callback
GOOGLE_REDIRECT_URI=
# Clés des fournisseurs d'IA, toutes facultatives. Chaque *_KEY_EXPIRES est l'échéance déclarée de la
# clé (AAAA-MM-JJ) : alerte à J-14 puis à J-3. Une clé enregistrée dans les Réglages l'emporte.
ANTHROPIC_API_KEY=
ANTHROPIC_KEY_EXPIRES=
OPENAI_API_KEY=
OPENAI_KEY_EXPIRES=
GEMINI_API_KEY=
GEMINI_KEY_EXPIRES=
MISTRAL_API_KEY=
MISTRAL_KEY_EXPIRES=
# Point d'accès compatible OpenAI (http:// ou https://), par exemple un modèle local.
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_KEY_EXPIRES=
# Évaluation de Pina (npm run pina:eval, à la main, jamais en CI) : une clé de test, pas celle d'Acedia.
# PINA_EVAL_PROVIDER = anthropic | openai | google | mistral | custom ; PINA_EVAL_BASE_URL pour custom.
PINA_EVAL_PROVIDER=
PINA_EVAL_MODEL=
PINA_EVAL_KEY=
