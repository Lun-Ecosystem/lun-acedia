# Copier en .env et renseigner. Ne jamais versionner .env.
# Local : clés de développement et compte Google de test uniquement.
# Adresse d'écoute : 127.0.0.1 par défaut (ce poste seulement). Un déploiement donne son adresse.
HOST=127.0.0.1
PORT=8787
DB_PATH=./data/acedia.db
# Clé de chiffrement des jetons Google : 32 octets en base64
# (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
ACEDIA_SECRET_KEY=
# Client OAuth Google (type « Application Web »), voir docs/brancher-google.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Par défaut : http://localhost:<PORT>/oauth/callback
GOOGLE_REDIRECT_URI=
ANTHROPIC_API_KEY=
# Échéance déclarée de la clé (AAAA-MM-JJ), facultative : alerte à J-14 puis à J-3.
# Une clé enregistrée dans les Réglages l'emporte sur ces deux lignes.
ANTHROPIC_KEY_EXPIRES=
